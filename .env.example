# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ---------------------------------------------------------------------------
# Local stack: run `npm run db:start` and copy the printed API URL / anon key.
# Hosted: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Supabase — server only (NEVER expose, never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Bypasses Row Level Security. Required only by content-ingestion/admin scripts,
# never by request-handling application code. Leave blank in normal development.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin used for auth redirects and absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
